{
  "name": "ergo-bridge",
  "productName": "Ergo Bridge",
  "version": "0.1.0",
  "description": "Connects the Ergo web app to this computer.",
  "author": "KonurPapa",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "electron-updater": "6.8.10",
    "node-pty": "1.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.21.5",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.21.5": true,
    "sharp@0.34.5": true,
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
